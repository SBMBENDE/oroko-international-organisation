# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/oroko-international

# Auth.js / NextAuth secret — generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-strong-random-secret

# App URL (no trailing slash)
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# Cloudinary — cloud name is public (needed by upload widget in browser)
# API key and secret are SERVER-ONLY — never add NEXT_PUBLIC_ prefix to them
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Stripe — secret key is SERVER-ONLY, publishable key is safe for browser
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
